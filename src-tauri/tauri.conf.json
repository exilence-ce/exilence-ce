{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exilence CE NG",
  "identifier": "com.exilence.exilence-ce-ng",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Exilence CE NG",
        "width": 1150,
        "height": 800,
        "minWidth": 1150,
        "minHeight": 800,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self' https://web.poecdn.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "desktopTemplate": "../packaging/linux/exilence-ce-ng.desktop" },
      "rpm": { "desktopTemplate": "../packaging/linux/exilence-ce-ng.desktop" }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1MUQyRDRCNTQ2N0JEMTgKUldRWXZXZFVTeTBkOVJKNlg5UTErakV0T1JPR3UvTUVEMlRBTFpUTnoxN3BIOEhIWS92UXlzVFQK",
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": { "schemes": ["exilence-ce-ng"] }
    }
  }
}
